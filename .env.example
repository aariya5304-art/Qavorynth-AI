# ---- Backend (set as environment variables on your API host) ----
# Comma-separated list of frontend origins allowed to call the API
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Optional regex for preview URLs, e.g. ^https://qavorynth-.*\.vercel\.app$
CORS_ORIGIN_REGEX=
# Max simultaneous in-memory visitor sessions
MAX_SESSIONS=200

# ---- Frontend (set in frontend/.env or in the hosting dashboard) ----
VITE_API_BASE_URL=http://localhost:8000
